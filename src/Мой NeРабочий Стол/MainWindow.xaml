<Window x:Class="DiskAnalyzer67.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Мой_NeРабочий_Стол"
        mc:Ignorable="d"
 Title="Анализатор дискового пространства"
        Width="1200"
        Height="760"
        MinWidth="900"
        MinHeight="600">

    <Grid Margin="16">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <!-- ============================================ -->
        <!-- ВЫБОР ПАПКИ -->
        <!-- ============================================ -->

        <Border Grid.Row="0"
                Margin="0,0,0,12"
                Padding="12"
                Background="#F2F2F2"
                CornerRadius="8">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="100"/>
                </Grid.ColumnDefinitions>


                <TextBox x:Name="PathTextBox"
                         Grid.Column="0"
                         Height="32"
                         Margin="0,0,8,0"
                         VerticalContentAlignment="Center"/>


                <Button x:Name="BrowseButton"
                        Grid.Column="1"
                        Height="32"
                        Margin="0,0,8,0"
                        Content="Обзор..."
                        Click="BrowseButton_Click"/>


                <Button x:Name="ScanButton"
                        Grid.Column="2"
                        Height="32"
                        Margin="0,0,8,0"
                        Content="Сканировать"
                        Click="ScanButton_Click"/>


                <Button x:Name="CancelButton"
                        Grid.Column="3"
                        Height="32"
                        Content="Отмена"
                        IsEnabled="False"
                        Click="CancelButton_Click"/>

            </Grid>

        </Border>


        <!-- ============================================ -->
        <!-- ПОИСК / ФИЛЬТР / СОРТИРОВКА -->
        <!-- ============================================ -->

        <Grid Grid.Row="1"
      Margin="0,0,0,12">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="170"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="SearchTextBox"
             Grid.Column="0"
             Height="32"
             Margin="0,0,8,0"
             VerticalContentAlignment="Center"
             ToolTip="Поиск по имени и полному пути"
             TextChanged="SearchTextBox_TextChanged"/>

            <ComboBox x:Name="TypeFilterComboBox"
              Grid.Column="1"
              Height="32"
              Margin="0,0,8,0"
              SelectedIndex="0"
              SelectionChanged="TypeFilterComboBox_SelectionChanged">

                <ComboBoxItem>
                    Все
                </ComboBoxItem>

                <ComboBoxItem>
                    Только файлы
                </ComboBoxItem>

                <ComboBoxItem>
                    Только папки
                </ComboBoxItem>

            </ComboBox>

            <ComboBox x:Name="SortComboBox"
              Grid.Column="2"
              Height="32"
              Margin="0,0,8,0"
              SelectedIndex="1"
              SelectionChanged="SortComboBox_SelectionChanged">

                <ComboBoxItem>
                    Имя
                </ComboBoxItem>

                <ComboBoxItem>
                    Размер
                </ComboBoxItem>

                <ComboBoxItem>
                    Путь
                </ComboBoxItem>

                <ComboBoxItem>
                    Тип
                </ComboBoxItem>

            </ComboBox>

            <ComboBox x:Name="SortDirectionComboBox"
              Grid.Column="3"
              Height="32"
              SelectedIndex="1"
              SelectionChanged="SortDirectionComboBox_SelectionChanged">

                <ComboBoxItem>
                    По возрастанию
                </ComboBoxItem>

                <ComboBoxItem>
                    По убыванию
                </ComboBoxItem>

            </ComboBox>

        </Grid>


        <!-- ============================================ -->
        <!-- НАСТРОЙКИ И СТАТИСТИКА -->
        <!-- ============================================ -->

        <Grid Grid.Row="2"
              Margin="0,0,0,12">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>


            <CheckBox x:Name="RecursiveCheckBox"
                      Grid.Column="0"
                      VerticalAlignment="Center"
                      Margin="0,0,24,0"
                      IsChecked="True"
                      Content="Показывать содержимое подпапок"
                      ToolTip="Без галочки показываются только объекты выбранной папки, но размеры подпапок всё равно рассчитываются."/>


            <TextBlock x:Name="FilesCountTextBlock"
                       Grid.Column="1"
                       Margin="0,0,24,0"
                       FontWeight="SemiBold"
                       Text="Файлов: 0"/>


            <TextBlock x:Name="FoldersCountTextBlock"
                       Grid.Column="2"
                       Margin="0,0,24,0"
                       FontWeight="SemiBold"
                       Text="Папок: 0"/>


            <TextBlock x:Name="TotalSizeTextBlock"
                       Grid.Column="3"
                       FontWeight="SemiBold"
                       Text="Размер: 0 Б"/>


            <TextBlock x:Name="ProgressTextBlock"
                       Grid.Column="4"
                       Margin="24,0,0,0"
                       Foreground="#666666"
                       Text="Готово"/>

        </Grid>


        <!-- ============================================ -->
        <!-- ВКЛАДКИ -->
        <!-- ============================================ -->

        <TabControl Grid.Row="3"
                    x:Name="MainTabControl">

            <!-- ============================== -->
            <!-- РЕЗУЛЬТАТЫ -->
            <!-- ============================== -->

            <TabItem Header="Результаты">

                <DataGrid x:Name="ItemsDataGrid"
                          AutoGenerateColumns="False"
                          CanUserSortColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          MouseDoubleClick="ItemsDataGrid_MouseDoubleClick">

                    <DataGrid.Columns>

                        <DataGridTextColumn Header="Имя"
                                            Binding="{Binding Name}"
                                            Width="2*"/>

                        <DataGridTextColumn Header="Тип"
                                            Binding="{Binding Type}"
                                            Width="120"/>

                        <DataGridTextColumn Header="Размер"
                                            Binding="{Binding SizeText}"
                                            Width="120"/>

                        <DataGridTextColumn Header="Путь"
                                            Binding="{Binding FullPath}"
                                            Width="3*"/>

                    </DataGrid.Columns>

                </DataGrid>

            </TabItem>


            <!-- ============================== -->
            <!-- ДИАГРАММА -->
            <!-- ============================== -->

            <TabItem Header="Заполнение">

                <ScrollViewer VerticalScrollBarVisibility="Auto">

                    <StackPanel x:Name="UsageChartPanel"
                                Margin="12"/>

                </ScrollViewer>

            </TabItem>


            <!-- ============================== -->
            <!-- НЕДОСТУПНЫЕ -->
            <!-- ============================== -->

            <TabItem Header="Недоступные">

                <Grid Margin="12">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>


                    <TextBlock Grid.Row="0"
                               Margin="0,0,0,8"
                               TextWrapping="Wrap"
                               Foreground="#555555"
                               Text="Здесь отображаются пути объектов, которые программа не смогла прочитать из-за ограничений доступа или ошибок файловой системы."/>

                    <ListBox x:Name="InaccessibleListBox"
                             Grid.Row="1"/>

                </Grid>

            </TabItem>

        </TabControl>


        <!-- ============================================ -->
        <!-- ПАГИНАЦИЯ И СТАТУС -->
        <!-- ============================================ -->

        <Grid Grid.Row="4"
              Margin="0,12,0,0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>


            <Button x:Name="PreviousPageButton"
                    Grid.Column="0"
                    Width="110"
                    Height="32"
                    Margin="0,0,8,0"
                    Content="← Назад"
                    IsEnabled="False"
                    Click="PreviousPageButton_Click"/>


            <TextBlock x:Name="PageTextBlock"
                       Grid.Column="1"
                       Width="150"
                       VerticalAlignment="Center"
                       TextAlignment="Center"
                       Text="Страница 1 из 1"/>


            <Button x:Name="NextPageButton"
                    Grid.Column="2"
                    Width="110"
                    Height="32"
                    Margin="8,0,0,0"
                    Content="Вперёд →"
                    IsEnabled="False"
                    Click="NextPageButton_Click"/>


            <Border Grid.Column="3"
                    Margin="16,0,0,0"
                    Padding="10"
                    Background="#F2F2F2"
                    CornerRadius="6">

                <TextBlock x:Name="StatusTextBlock"
                           Text="Выберите папку и нажмите «Сканировать»."
                           TextWrapping="Wrap"/>

            </Border>

        </Grid>

    </Grid>

</Window>