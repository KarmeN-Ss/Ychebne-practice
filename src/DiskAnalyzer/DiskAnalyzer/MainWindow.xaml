<Window x:Class="DiskAnalyzer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Анализатор дискового пространства"
        Height="720"
        Width="1100"
        MinHeight="600"
        MinWidth="850">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="12" CornerRadius="8" Background="#F2F2F2" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="110"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="PathTextBox" Grid.Column="0" Height="32" VerticalContentAlignment="Center" Margin="0,0,8,0"/>
                <Button Grid.Column="1" Content="Обзор..." Height="32" Margin="0,0,8,0" Click="BrowseButton_Click"/>
                <Button x:Name="ScanButton" Grid.Column="2" Content="Сканировать" Height="32" Margin="0,0,8,0" Click="ScanButton_Click"/>
                <Button x:Name="CancelButton" Grid.Column="3" Content="Отмена" Height="32" IsEnabled="False" Click="CancelButton_Click"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="230"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchTextBox" Grid.Column="0" Height="32" VerticalContentAlignment="Center" Margin="0,0,8,0"
                     ToolTip="Поиск по имени и полному пути"
                     TextChanged="SearchTextBox_TextChanged"/>
            <ComboBox x:Name="SortComboBox" Grid.Column="1" Height="32" SelectedIndex="0"
                      SelectionChanged="SortComboBox_SelectionChanged">
                <ComboBoxItem>Размер ↓</ComboBoxItem>
                <ComboBoxItem>Размер ↑</ComboBoxItem>
                <ComboBoxItem>Имя А-Я</ComboBoxItem>
                <ComboBoxItem>Имя Я-А</ComboBoxItem>
            </ComboBox>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock x:Name="FilesCountTextBlock" Margin="0,0,24,0" FontWeight="SemiBold" Text="Файлов: 0"/>
            <TextBlock x:Name="FoldersCountTextBlock" Margin="0,0,24,0" FontWeight="SemiBold" Text="Папок: 0"/>
            <TextBlock x:Name="TotalSizeTextBlock" FontWeight="SemiBold" Text="Размер: 0 Б"/>
            <TextBlock x:Name="ProgressTextBlock" Margin="24,0,0,0" Foreground="#666666" Text="Готово"/>
        </StackPanel>

        <DataGrid x:Name="ItemsDataGrid" Grid.Row="3" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserSortColumns="False" SelectionMode="Single" SelectionUnit="FullRow"
                  MouseDoubleClick="ItemsDataGrid_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Имя" Binding="{Binding Name}" Width="2*"/>
                <DataGridTextColumn Header="Тип" Binding="{Binding Type}" Width="120"/>
                <DataGridTextColumn Header="Размер" Binding="{Binding SizeText}" Width="120"/>
                <DataGridTextColumn Header="Путь" Binding="{Binding FullPath}" Width="3*"/>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="4" Margin="0,12,0,0" Padding="10" Background="#F2F2F2" CornerRadius="6">
            <TextBlock x:Name="StatusTextBlock" Text="Выберите папку и нажмите «Сканировать»." TextWrapping="Wrap"/>
        </Border>
    </Grid>
</Window>
